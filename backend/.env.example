# Server Environment
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
MONGODB_URI=mongodb://localhost:27017/fake_news_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=generate_with__node_-e__require_crypto_.randomBytes_48_.toString_hex_
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_with__node_-e__require_crypto_.randomBytes_48_.toString_hex_
JWT_REFRESH_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=generate_with__node_-e__require_crypto_.randomBytes_32_.toString_hex_

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# External APIs (Optional)
FACT_CHECK_API_KEY=
WHOIS_API_KEY=

# AI Service Environment
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API Security
API_KEY=generate_with__node_-e__require_crypto_.randomBytes_32_.toString_hex_

# Model Configuration
# Set to "true" to download and use transformer models (~2GB, slower first start)
USE_TRANSFORMER_MODELS=false
MODEL_CACHE_DIR=./models

# spaCy
SPACY_MODEL=en_core_web_sm

# External APIs (Optional)
FACT_CHECK_API_KEY=
WHOIS_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
